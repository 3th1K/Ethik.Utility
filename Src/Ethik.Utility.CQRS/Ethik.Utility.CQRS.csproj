<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Title>Ethik.Utility.CQRS</Title>
		<Description>This NuGet package provides a set of utilities for implementing command query segrigation in .NET applications.</Description>
		<PackageProjectUrl>https://www.nuget.org/packages/Ethik.Utility.CQRS</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Version>1.0.0</Version>
		<Authors>Mehedi Rahaman</Authors>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>$(NoWarn);S125</NoWarn>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
	<None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
